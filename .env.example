# Shared database used by the API, worker, and migration commands.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001

# Passwordless authentication. Create a Google OAuth web client with this callback:
# http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Create an API key and verify the sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="home <auth@example.com>"

# Encrypt connector tokens at rest. Generate independently from BETTER_AUTH_SECRET.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Gmail can reuse GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET. Add this callback to Google:
# http://localhost:3001/v1/connections/gmail/callback
# Optional dedicated connector credentials override the login client.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Slack and Linear connector OAuth applications.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Cloudflare R2 attachments (S3-compatible API credentials).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=home-attachments

# Optional topic search. RSS feeds and deterministic briefings work without it.
TAVILY_API_KEY=

# Browser-facing URLs. Production should use sibling subdomains such as
# https://app.example.com and https://api.example.com.
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
ADDITIONAL_TRUSTED_ORIGINS=

# Set only in production to the shared parent domain (for example example.com).
AUTH_COOKIE_DOMAIN=
# Enable only when web and API use unrelated HTTPS origins, such as Railway's
# generated *.up.railway.app domains. Prefer sibling custom domains long-term.
AUTH_CROSS_SITE_COOKIES=false

# Local service ports. Conductor overrides these from its allocated range.
HOME_WEB_PORT=3000
HOME_API_PORT=3001

# Worker process identity for queue coordination.
WORKER_NAME=home-worker
